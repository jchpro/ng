{
  "name": "@jchpro/ng",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --project docs-app",
    "build": "npm run build:common:prod && npm run build:material:prod && npm run build:admin:prod && npm run build:app:prod",
    "build:app:dev": "ng build --project docs-app --configuration development",
    "build:app:prod": "ng build --project docs-app --configuration production",
    "build:common:dev": "ng build --project @jchpro/ngx-common --configuration development",
    "watch:common:dev": "ng build --watch --project @jchpro/ngx-common --configuration development",
    "build:common:prod": "ng build --project @jchpro/ngx-common --configuration production",
    "build:material:dev": "ng build --project @jchpro/ngx-material --configuration development",
    "watch:material:dev": "ng build --watch --project @jchpro/ngx-material --configuration development",
    "build:material:prod": "ng build --project @jchpro/ngx-material --configuration production",
    "build:admin:dev": "ng build --project @jchpro/ngx-admin --configuration development",
    "watch:admin:dev": "ng build --watch --project @jchpro/ngx-admin --configuration development",
    "build:admin:prod": "ng build --project @jchpro/ngx-admin --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:common && npm run test:material",
    "test:common": "ng test @jchpro/ngx-common --watch=false --browsers=ChromeHeadless",
    "test:material": "ng test @jchpro/ngx-material --watch=false --browsers=ChromeHeadless",
    "test-local:common": "ng test @jchpro/ngx-common",
    "test-local:material": "ng test @jchpro/ngx-material",
    "test-local:admin": "ng test @jchpro/ngx-admin"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.17",
    "@angular/compiler": "^20.3.17",
    "@angular/core": "^20.3.17",
    "@angular/forms": "^20.3.17",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.17",
    "@angular/platform-browser-dynamic": "^20.3.17",
    "@angular/router": "^20.3.17",
    "@fortawesome/angular-fontawesome": "^3.0.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "commander": "^13.1.0",
    "dotenv": "^16.6.1",
    "highlight.js": "^11.11.1",
    "lodash": "^4.17.23",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.3.19",
    "@angular/cli": "^20.3.19",
    "@angular/compiler-cli": "^20.3.17",
    "@types/jasmine": "~5.1.0",
    "@types/lodash": "^4.17.24",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.3.2",
    "typescript": "~5.8.3"
  },
  "packageManager": "pnpm@10.26.2+sha512.0e308ff2005fc7410366f154f625f6631ab2b16b1d2e70238444dd6ae9d630a8482d92a451144debc492416896ed16f7b114a86ec68b8404b2443869e68ffda6"
}
