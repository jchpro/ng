{
  "name": "@jchpro/ng",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --project docs-app",
    "build": "npm run build:common:prod && npm run build:app:prod",
    "build:app:dev": "ng build --project docs-app --configuration development",
    "build:app:prod": "ng build --project docs-app --configuration production",
    "build:common:dev": "ng build --project @jchpro/ngx-common --configuration development",
    "watch:common:dev": "ng build --watch --project @jchpro/ngx-common --configuration development",
    "build:common:prod": "ng build --project @jchpro/ngx-common --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:common",
    "test:common": "ng test @jchpro/ngx-common --watch=false --browsers=ChromeHeadless",
    "test-local:common": "ng test @jchpro/ngx-common"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.1.7",
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/platform-browser-dynamic": "^22.1.7",
    "@angular/router": "^22.1.7",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "commander": "^13.1.0",
    "dotenv": "^16.6.1",
    "highlight.js": "^11.11.1",
    "lodash": "^4.17.23",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.7",
    "@types/jasmine": "~5.1.0",
    "@types/lodash": "^4.17.24",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^22.1.1",
    "typescript": "~6.0.3",
    "zone.js": "^0.15.1"
  },
  "packageManager": "npm@11.17.0"
}
